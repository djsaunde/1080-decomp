From: djsaunde <1245942+djsaunde@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:00:01 -0500
Subject: [PATCH 14/16] fast: sample scaled TEXRECTs at the RDP's texel
 positions

The RDP evaluates a texture rectangle's s at a pixel's corner,
s = uls + x * dsdx, and its bilinear / 3-point filter has texel centres
on whole s. GL interpolates at pixel centres and has texel centres on
halves. For triangles the interpreter adds half a texel; rectangles got
nothing, which is right only for 1:1 rectangles. A scaled one sampled
0.5 - 0.5 * dsdx texels low: 1080's Fader stretches a 32x32 mask over the
screen (dsdx 0.097), sampled 0.45 texel low, so its first column wrapped
into its last and the whole mask sat ~5 pixels right of the N64's; the
dark border of a fade thinned out on the right and appeared on the left
(title demo step 4838).

With a filtering texture, a TEXRECT's coordinates are now offset by
0.5 - 0.5 * step (dsdx / dtdy after the tile shift). 1:1 rectangles get
0, so patch 0009's strips and point-sampled rectangles are unchanged.
---
 include/fast/interpreter.h |  1 +
 src/fast/interpreter.cpp   | 17 +++++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/include/fast/interpreter.h b/include/fast/interpreter.h
index 3e8440b..5631992 100644
--- a/include/fast/interpreter.h
+++ b/include/fast/interpreter.h
@@ -477,6 +477,7 @@ class Interpreter {
     void GfxSpTri1(uint8_t vtx1Idx, uint8_t vtx2Idx, uint8_t vtx3Idx, bool isRect);
     bool RectInsideTexture(struct LoadedVertex* const vArr[3], uint32_t tile, uint32_t size, bool s);
     bool mRectUnitTexel[2] = { false, false }; // the TEXRECT being drawn maps 1:1 from a whole texel in s / t
+    float mRectTexelStep[2] = { 1.0f, 1.0f }; // the TEXRECT being drawn: dsdx, dtdy in texels per pixel
     void GfxSpLine3D(uint8_t vtx1Idx, uint8_t vtx2Idx, uint8_t width);
     // RSP-style clipping (gfx_set_rsp_clipping): a triangle crossing the near plane or the side planes at the clip
     // ratio is clipped here in clip space, as the F3DEX microcodes do, instead of being left to the GPU.
diff --git a/src/fast/interpreter.cpp b/src/fast/interpreter.cpp
index c2b4591..3fbec68 100644
--- a/src/fast/interpreter.cpp
+++ b/src/fast/interpreter.cpp
@@ -2322,6 +2322,20 @@ void Interpreter::GfxSpTri1(uint8_t vtx1_idx, uint8_t vtx2_idx, uint8_t vtx3_idx
                 if (!is_rect) {
                     u += 0.5f;
                     v += 0.5f;
+                } else {
+                    // The RDP samples a rectangle's pixel at its corner, s = uls + x * dsdx, and its filter puts
+                    // texel centres on whole s; GL samples at pixel centres and puts them on halves. A scaled
+                    // rectangle (the Fader's 32x32 mask over the screen) would sample half a texel low and wrap
+                    // its first column into its last. 1:1 rectangles are unchanged (the offset is 0).
+                    float step_s = mRectTexelStep[0], step_t = mRectTexelStep[1];
+                    if (shifts != 0) {
+                        step_s = shifts <= 10 ? step_s / (1 << shifts) : step_s * (1 << (16 - shifts));
+                    }
+                    if (shiftt != 0) {
+                        step_t = shiftt <= 10 ? step_t / (1 << shiftt) : step_t * (1 << (16 - shiftt));
+                    }
+                    u += 0.5f - 0.5f * step_s;
+                    v += 0.5f - 0.5f * step_t;
                 }
             }
 
@@ -3254,8 +3268,11 @@ void Interpreter::GfxDpTextureRectangle(int32_t ulx, int32_t uly, int32_t lrx, i
     // 1:1 from a whole texel: the RDP samples texel corners with no blend (patch 0009)
     mRectUnitTexel[0] = (dsdx == (1 << 10) || dsdx == -(1 << 10)) && (uls & 31) == 0;
     mRectUnitTexel[1] = (dtdy == (1 << 10) || dtdy == -(1 << 10)) && (ult & 31) == 0;
+    mRectTexelStep[0] = dsdx / 1024.0f;
+    mRectTexelStep[1] = dtdy / 1024.0f;
     GfxDrawRectangle(ulx, uly, lrx, lry);
     mRectUnitTexel[0] = mRectUnitTexel[1] = false;
+    mRectTexelStep[0] = mRectTexelStep[1] = 1.0f;
     if (saved_tile != tile) {
         mRdp->textures_changed[0] = true;
         mRdp->textures_changed[1] = true;
