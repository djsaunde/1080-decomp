+#ifdef USE_OPENGLES
+// OpenGL ES 3.0: four desktop features Fast3D relies on are extensions there. Without them noperspective varyings
+// are emulated (the vertex shader outputs the varying times w and w itself; their perspective-correct quotient is the
+// screen-linear value), the far plane is clamped in the vertex shader instead of by GL_DEPTH_CLAMP, mirror-clamp
+// falls back to mirrored repeat, and depth is read through a depth texture (GetPixelDepth). FAST_GLES_NO_EXT=1 takes
+// the fallbacks even when the extensions exist (tests).
+static bool sGlesNoperspective = false; // GL_NV_shader_noperspective_interpolation
+static bool sGlesDepthClamp = false;    // GL_EXT_depth_clamp
+static bool sGlesMirrorClamp = false;   // GL_EXT_texture_mirror_clamp_to_edge
+static bool sGlesReadDepth = false;     // GL_NV_read_depth (GetPixelDepth; else a blit into a depth texture)
+#ifndef GL_DEPTH_CLAMP_EXT
+#define GL_DEPTH_CLAMP_EXT 0x864F
+#endif
+
+static bool GlesHasExtension(const char* name) {
+    GLint n = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &n);
+    for (GLint i = 0; i < n; i++) {
+        const char* e = (const char*)glGetStringi(GL_EXTENSIONS, (GLuint)i);
+        if (e != nullptr && strcmp(e, name) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void GlesDetectExtensions() {
+    // FAST_GLES_NO_EXT: 1 = every fallback, or a list of noperspective / depth_clamp / mirror_clamp / read_depth
+    const char* off = getenv("FAST_GLES_NO_EXT");
+    auto no = [off](const char* what) {
+        return off != nullptr && (strcmp(off, "1") == 0 || strstr(off, what) != nullptr);
+    };
+    sGlesNoperspective = !no("noperspective") && GlesHasExtension("GL_NV_shader_noperspective_interpolation");
+    sGlesDepthClamp = !no("depth_clamp") && GlesHasExtension("GL_EXT_depth_clamp");
+    sGlesMirrorClamp = !no("mirror_clamp") && GlesHasExtension("GL_EXT_texture_mirror_clamp_to_edge");
+    sGlesReadDepth = !no("read_depth") &&
+                     (GlesHasExtension("GL_NV_read_depth") || GlesHasExtension("GL_NV_read_depth_stencil"));
+    fprintf(stderr, "fast: %s: noperspective %s, depth clamp %s, mirror clamp %s, depth read %s\n",
+            (const char*)glGetString(GL_VERSION), sGlesNoperspective ? "yes" : "emulated",
+            sGlesDepthClamp ? "yes" : "vertex shader", sGlesMirrorClamp ? "yes" : "mirrored repeat",
+            sGlesReadDepth ? "NV_read_depth" : "depth texture");
+}
+
+// the shader's noperspective handling: "in"/"out" qualifiers, or the emulation (np_emul, the varyings named ...Np)
+static const char* GlesFsVersion() {
+    if (sAffineShading && sGlesNoperspective) {
+        return "#version 300 es\n#extension GL_NV_shader_noperspective_interpolation : require\n"
+               "precision highp float;\nprecision highp int;\nprecision highp sampler2D;";
+    }
+    return "#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;";
+}
+
+static const char* GlesVsVersion() {
+    if (sAffineShading && sGlesNoperspective) {
+        return "#version 300 es\n#extension GL_NV_shader_noperspective_interpolation : require";
+    }
+    return "#version 300 es";
+}
+#define GLES_NP_EMUL (sAffineShading && !sGlesNoperspective)
+#else
+#define GLES_NP_EMUL false
+#endif
