     glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
 }
 
+#ifdef USE_OPENGLES
+// ES 3.0 reads no depth with glReadPixels. With GL_NV_read_depth it can (GetPixelDepth reads each pixel). Without it,
+// each requested pixel's depth is blitted into a DEPTH24_STENCIL8 texture (one texel per coordinate, as the desktop
+// path blits into mPixelDepthRb), a full-screen triangle writes each texel's 24-bit depth into an RGBA8 target, and
+// that is read back. Either way the values equal the desktop path's ((d24 >> 10) << 2). The blit needs the source's
+// depth to be DEPTH24_STENCIL8 too: Fast3D's framebuffers are, a host drawing into the window asks for a 24-bit depth
+// + 8-bit stencil surface (some drivers still blit no depth from the window: Mesa's llvmpipe reads 0 there). If the
+// blit fails the pixels read as the far plane (0xFFFC), logged once.
+namespace {
+struct GlesDepthRead {
+    GLuint tex = 0, texFb = 0, colorRb = 0, colorFb = 0, prog = 0, vao = 0;
+    size_t size = 0;
+    bool broken = false, warned = false;
+};
+GlesDepthRead sGlesDepth;
+
+GLuint GlesCompile(GLenum type, const char* src) {
+    GLuint sh = glCreateShader(type);
+    glShaderSource(sh, 1, &src, nullptr);
+    glCompileShader(sh);
+    GLint ok = 0;
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[1024];
+        GLsizei n = 0;
+        glGetShaderInfoLog(sh, sizeof(log), &n, log);
+        fprintf(stderr, "fast: depth read-back shader: %.*s\n", (int)n, log);
+    }
+    return sh;
+}
+
+bool GlesDepthReadInit(GlesDepthRead& d) {
+    if (d.prog != 0 || d.broken) {
+        return !d.broken;
+    }
+    static const char* vs = "#version 300 es\n"
+                            "void main() {\n"
+                            "    gl_Position = vec4(float((gl_VertexID & 1) * 4 - 1), float((gl_VertexID & 2) * 2 - 1), "
+                            "0.0, 1.0);\n"
+                            "}\n";
+    static const char* fs = "#version 300 es\n"
+                            "precision highp float;\n"
+                            "precision highp int;\n"
+                            "uniform highp sampler2D uDepth;\n"
+                            "out vec4 oColor;\n"
+                            "void main() {\n"
+                            "    float z = texelFetch(uDepth, ivec2(gl_FragCoord.xy), 0).r;\n"
+                            "    uint u = uint(clamp(round(z * 16777215.0), 0.0, 16777215.0));\n" // not + 0.5: 2^24 - 0.5 rounds up
+                            "    oColor = vec4(float((u >> 16) & 255u), float((u >> 8) & 255u), float(u & 255u), 255.0) / 255.0;\n"
+                            "}\n";
+    GLuint v = GlesCompile(GL_VERTEX_SHADER, vs), f = GlesCompile(GL_FRAGMENT_SHADER, fs);
+    d.prog = glCreateProgram();
+    glAttachShader(d.prog, v);
+    glAttachShader(d.prog, f);
+    glLinkProgram(d.prog);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    GLint ok = 0;
+    glGetProgramiv(d.prog, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        fprintf(stderr, "fast: depth read-back program failed to link: depth reads as the far plane\n");
+        d.broken = true;
+        return false;
+    }
+    glGenVertexArrays(1, &d.vao);
+    glGenTextures(1, &d.tex);
+    glGenFramebuffers(1, &d.texFb);
+    glGenRenderbuffers(1, &d.colorRb);
+    glGenFramebuffers(1, &d.colorFb);
+    return true;
+}
+
+void GlesDepthReadResize(GlesDepthRead& d, size_t n) {
+    if (d.size >= n) {
+        return;
+    }
+    glBindTexture(GL_TEXTURE_2D, d.tex);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, (GLsizei)n, 1, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8,
+                 nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glBindFramebuffer(GL_FRAMEBUFFER, d.texFb);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, d.tex, 0);
+    glBindRenderbuffer(GL_RENDERBUFFER, d.colorRb);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, (GLsizei)n, 1);
+    glBindRenderbuffer(GL_RENDERBUFFER, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, d.colorFb);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, d.colorRb);
+    d.size = n;
+}
+} // namespace
+#endif
+
 std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
 GfxRenderingAPIOGL::GetPixelDepth(int fb_id, const std::set<std::pair<float, float>>& coordinates) {
     std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> res;
 
     FramebufferOGL& fb = mFrameBuffers[fb_id];
 
+#ifdef USE_OPENGLES
+    {
+        GlesDepthRead& d = sGlesDepth;
+        const size_t n = coordinates.size();
+        std::vector<uint32_t> d24(n, 0xFFFFFFu); // the far plane unless read
+        bool ok = n != 0;
+        for (int e = 0; e < 16 && glGetError() != GL_NO_ERROR; e++) {
+        }
+        GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+        if (ok && sGlesReadDepth) {
+            // GL_NV_read_depth: glReadPixels of GL_DEPTH_COMPONENT as 32-bit unsigned integers, whose top 24 bits are
+            // the 24-bit depth (the window's depth too, which some drivers do not blit)
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, fb.fbo);
+            glPixelStorei(GL_PACK_ALIGNMENT, 4);
+            size_t i = 0;
+            for (const auto& coord : coordinates) {
+                int x = coord.first;
+                int y = coord.second;
+                if (fb.invertY) {
+                    y = fb.height - y;
+                }
+                GLuint v = 0xFFFFFFFFu;
+                glReadPixels(x, y, 1, 1, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, &v);
+                d24[i++] = v >> 8;
+            }
+            const GLenum err = glGetError();
+            if (err != GL_NO_ERROR) {
+                if (!d.warned) {
+                    d.warned = true;
+                    fprintf(stderr, "fast: depth read-back (NV_read_depth) failed: GL error 0x%x; trying the blit\n", err);
+                }
+                sGlesReadDepth = false;
+                std::fill(d24.begin(), d24.end(), 0xFFFFFFu);
+            } else {
+                ok = false; // read: no blit
+            }
+        }
+        if (ok && GlesDepthReadInit(d)) {
+            std::vector<uint8_t> rgba(n * 4, 0);
+            GLint prevActive = 0, prevTex0 = 0, prevProg = 0, prevVao = 0, prevVp[4];
+            glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+            glActiveTexture(GL_TEXTURE0);
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex0);
+            glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+            glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+            glGetIntegerv(GL_VIEWPORT, prevVp);
+            const GLboolean depthTest = glIsEnabled(GL_DEPTH_TEST), blend = glIsEnabled(GL_BLEND),
+                            cull = glIsEnabled(GL_CULL_FACE);
+            GLboolean colorMask[4], depthMask;
+            glGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+            glGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+            GlesDepthReadResize(d, n);
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, fb.fbo);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, d.texFb);
+            glDisable(GL_SCISSOR_TEST);
+            size_t i = 0;
+            for (const auto& coord : coordinates) {
+                int x = coord.first;
+                int y = coord.second;
+                if (fb.invertY) {
+                    y = fb.height - y;
+                }
+                glBlitFramebuffer(x, y, x + 1, y + 1, (GLint)i, 0, (GLint)i + 1, 1,
+                                  GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT, GL_NEAREST);
+                ++i;
+            }
+            const GLenum blitErr = glGetError();
+            if (blitErr == GL_NO_ERROR) {
+                glBindFramebuffer(GL_FRAMEBUFFER, d.colorFb);
+                glViewport(0, 0, (GLsizei)n, 1);
+                glDisable(GL_DEPTH_TEST);
+                glDisable(GL_BLEND);
+                glDisable(GL_CULL_FACE);
+                glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+                glUseProgram(d.prog);
+                glUniform1i(glGetUniformLocation(d.prog, "uDepth"), 0);
+                glBindTexture(GL_TEXTURE_2D, d.tex);
+                glBindVertexArray(d.vao);
+                glDrawArrays(GL_TRIANGLES, 0, 3);
+                glPixelStorei(GL_PACK_ALIGNMENT, 1);
+                glReadPixels(0, 0, (GLsizei)n, 1, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+                for (size_t k = 0; k < n; k++) {
+                    d24[k] = ((uint32_t)rgba[k * 4] << 16) | ((uint32_t)rgba[k * 4 + 1] << 8) | rgba[k * 4 + 2];
+                }
+            } else if (!d.warned) {
+                d.warned = true;
+                fprintf(stderr, "fast: depth read-back blit failed (GL error 0x%x; the framebuffer's depth is not "
+                        "DEPTH24_STENCIL8?): depth reads as the far plane\n", blitErr);
+            }
+            // restore what the draw changed
+            glBindVertexArray((GLuint)prevVao);
+            glUseProgram((GLuint)prevProg);
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex0);
+            glActiveTexture((GLenum)prevActive);
+            glViewport(prevVp[0], prevVp[1], prevVp[2], prevVp[3]);
+            glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+            glDepthMask(depthMask);
+            (depthTest ? glEnable : glDisable)(GL_DEPTH_TEST);
+            (blend ? glEnable : glDisable)(GL_BLEND);
+            (cull ? glEnable : glDisable)(GL_CULL_FACE);
+        }
+        (scissor ? glEnable : glDisable)(GL_SCISSOR_TEST);
+        size_t i = 0;
+        for (const auto& coord : coordinates) {
+            res.emplace(coord, (uint16_t)((d24[i++] >> 10) << 2));
+        }
+        glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+        return res;
+    }
+#endif
+
     // When looking up one value and the framebuffer is single-sampled, we can read pixels directly
     // Otherwise we need to blit first to a new buffer then read it
     if (coordinates.size() == 1 && fb.msaa_level <= 1) {
diff --git a/src/fast/shaders/opengl/default.shader.glsl b/src/fast/shaders/opengl/default.shader.glsl
index a121dd8..c444ecc 100644
--- a/src/fast/shaders/opengl/default.shader.glsl
+++ b/src/fast/shaders/opengl/default.shader.glsl
@@ -95,8 +95,8 @@
                 vInput@{i + 1} *= aVtxPos.w;
             @end
         @end
-        @if(opengles)
-            gl_Position.z *= 0.3f;
+        @if(far_clamp)
+            gl_Position.z = min(gl_Position.z, gl_Position.w);
         @end
     }
 @else
