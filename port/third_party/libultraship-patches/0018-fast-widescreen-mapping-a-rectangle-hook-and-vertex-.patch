+    // Widescreen (gfx_set_widescreen): the game view is wider than the native 4:3 and the native picture is centred in
+    // it at the view's height (AdjXForAspectRatio). Partial viewports and scissors, the depth read-back coordinates
+    // and the persistent colour images follow that mapping instead of stretching the native width over the view.
+    bool mWidescreen = false;
+    float WidescreenX(float x) const; // a native x to the view's pixels
+    // A port's hook on the RDP rectangles (gfx_set_rect_hook): called for every G_TEXRECT / G_TEXRECTFLIP /
+    // G_FILLRECT with the command and its U10.2 corners, which it may move (beyond the native screen too); setting
+    // *stretch draws the rectangle over the view's full width instead of the centred native picture.
+    void (*mRectHook)(const void* cmd, int32_t* ulx, int32_t* uly, int32_t* lrx, int32_t* lry, bool* stretch) = nullptr;
+    bool mRectStretch = false;
+    // Vertex replacements (SetVertexReplacements): a G_VTX whose source address is a key loads the mapped vertices.
+    const std::unordered_map<const void*, const void*>* mVtxReplacements = nullptr;
