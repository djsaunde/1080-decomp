diff --git a/src/fast/interpreter.cpp b/src/fast/interpreter.cpp
index 2a46b10..d439f54 100644
--- a/src/fast/interpreter.cpp
+++ b/src/fast/interpreter.cpp
@@ -5311,6 +5311,9 @@ void Interpreter::Run(Gfx* commands, const std::unordered_map<Mtx*, MtxF>& mtx_r
     }
 
     Flush();
+    if (!mFbActive) {
+        ServiceReadbacks();
+    }
     mGfxFrameBuffer = 0;
     currentDir = std::stack<std::string>();
 
@@ -5437,6 +5440,105 @@ void Interpreter::AdjustPixelDepthCoordinates(float& x, float& y) {
     }
 }
 
+void Interpreter::ReadbackRequestRgba5551(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint16_t* dst,
+                                          bool bswap) {
+    mReadbackRequests.push_back({ x, y, width, height, dst, bswap });
+}
+
+void Interpreter::ReadbackRequestDepth(uint32_t x, uint32_t y) {
+    mReadbackDepthRequests.emplace(x, y);
+}
+
+bool Interpreter::ReadbackGetDepth(uint32_t x, uint32_t y, uint16_t* depth) const {
+    auto it = mReadbackDepthResults.find(std::make_pair(x, y));
+    if (it == mReadbackDepthResults.end()) {
+        return false;
+    }
+    *depth = it->second;
+    return true;
+}
+
+void Interpreter::ServiceReadbacks() {
+    const int srcFb = mRendersToFb ? mGameFb : 0;
+
+    if (!mReadbackRequests.empty()) {
+        const uint32_t width = mNativeDimensions.width;
+        const uint32_t height = mNativeDimensions.height;
+
+        if (mReadbackFb < 0) {
+            mReadbackFb = mRapi->CreateFramebuffer();
+        }
+        if (mReadbackFbWidth != width || mReadbackFbHeight != height) {
+            mRapi->UpdateFramebufferParameters(mReadbackFb, width, height, 1, true, true, false, false);
+            mReadbackFbWidth = width;
+            mReadbackFbHeight = height;
+        }
+
+        // Same source area as CopyFrameBuffer, narrowed to its centre at the native aspect ratio
+        int srcX0, srcY0, srcW, srcH;
+        if (srcFb == 0 || (mMsaaLevel > 1 && mCurDimensions.width == mGameWindowViewport.width &&
+                           mCurDimensions.height == mGameWindowViewport.height)) {
+            srcX0 = mGameWindowViewport.x;
+            srcY0 = mGameWindowViewport.y;
+            srcW = mGameWindowViewport.width;
+            srcH = mGameWindowViewport.height;
+        } else {
+            srcX0 = 0;
+            srcY0 = 0;
+            srcW = mCurDimensions.width;
+            srcH = mCurDimensions.height;
+        }
+        if ((float)srcW / srcH > (float)width / height) {
+            int sliceW = (int)((float)srcH * width / height);
+            srcX0 += (srcW - sliceW) / 2;
+            srcW = sliceW;
+        }
+
+        mRapi->CopyFramebuffer(mReadbackFb, srcFb, srcX0, srcY0, srcX0 + srcW, srcY0 + srcH, 0, 0, width, height);
+        mReadbackBuffer.resize((size_t)width * height);
+        mRapi->ReadFramebufferToCPU(mReadbackFb, width, height, mReadbackBuffer.data());
+
+        for (const auto& req : mReadbackRequests) {
+            for (uint32_t row = 0; row < req.height; row++) {
+                for (uint32_t col = 0; col < req.width; col++) {
+                    const uint32_t x = req.x + col;
+                    const uint32_t y = req.y + row;
+                    uint16_t pixel = (x < width && y < height) ? mReadbackBuffer[(size_t)y * width + x] : 0;
+#ifndef IS_BIGENDIAN
+                    if (req.bswap) {
+                        pixel = BE16SWAP(pixel);
+                    }
+#endif
+                    req.dst[(size_t)row * req.width + col] = pixel;
+                }
+            }
+        }
+        mReadbackRequests.clear();
+    }
+
+    mReadbackDepthResults.clear();
+    if (!mReadbackDepthRequests.empty()) {
+        std::set<std::pair<float, float>> coordinates;
+        std::vector<std::pair<std::pair<uint32_t, uint32_t>, std::pair<float, float>>> lookups;
+        for (const auto& request : mReadbackDepthRequests) {
+            float x = request.first;
+            float y = request.second;
+            AdjustPixelDepthCoordinates(x, y);
+            coordinates.emplace(x, y);
+            lookups.emplace_back(request, std::make_pair(x, y));
+        }
+
+        std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> res =
+            mRapi->GetPixelDepth(srcFb, coordinates);
+        for (const auto& [request, coordinate] : lookups) {
+            if (auto it = res.find(coordinate); it != res.end()) {
+                mReadbackDepthResults.emplace(request, it->second);
+            }
+        }
+        mReadbackDepthRequests.clear();
+    }
+}
+
 void Interpreter::GetPixelDepthPrepare(float x, float y) {
     AdjustPixelDepthCoordinates(x, y);
     mGetPixelDepthPending.emplace(x, y);
@@ -5627,6 +5729,19 @@ extern "C" void gfx_texture_cache_clear() {
