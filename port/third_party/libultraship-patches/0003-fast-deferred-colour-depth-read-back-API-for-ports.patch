From: djsaunde <1245942+djsaunde@users.noreply.github.com>
Date: Mon, 16 Nov 2026 14:19:19 -0500
Subject: [PATCH 3/4] fast: deferred colour / depth read-back API for ports

Ports of code that reads the N64 colour or depth buffer from the CPU queue
requests before Run(); ServiceReadbacks() fulfils them at the end of Run(),
after the frame is drawn and before it is resolved / presented, so the game
thread never touches the GPU. Results are ready for the next update: one
frame of latency, the same as reading the last completed N64 framebuffer.

- ReadbackRequestRgba5551 / gfx_readback_rgba5551: a region in native
  coordinates, taken from the native-aspect centre of the game view scaled
  to the native size, as RGBA5551, optionally byte-swapped to big-endian.
- ReadbackRequestDepth / ReadbackGetDepth (gfx_readback_depth_*): batched
  depth at points, in GetPixelDepth units (far plane = 0xFFFC).
---
 include/fast/interpreter.h |  29 ++++++++++
 src/fast/interpreter.cpp   | 115 +++++++++++++++++++++++++++++++++++++
 2 files changed, 144 insertions(+)

diff --git a/include/fast/interpreter.h b/include/fast/interpreter.h
index f5c7703..15b4cfb 100644
--- a/include/fast/interpreter.h
+++ b/include/fast/interpreter.h
@@ -410,6 +410,18 @@ class Interpreter {
     void AdjustPixelDepthCoordinates(float& x, float& y);
     void GetPixelDepthPrepare(float x, float y);
     uint16_t GetPixelDepth(float x, float y);
+    // CPU read-back of the game's colour and depth buffers, for ports of code that reads the N64 framebuffer.
+    // Requests made before Run() are serviced at the end of that Run(), once the frame is drawn, so the results
+    // describe that frame and are ready for the game's next update: one frame of latency, like a game reading its
+    // last completed framebuffer. Coordinates are in native pixels (e.g. 320x240).
+    // Colour: dst receives width * height RGBA5551 pixels from the native-aspect centre of the game view, scaled to
+    // the native dimensions; bswap stores them big-endian, the N64 memory order the texture importers expect.
+    void ReadbackRequestRgba5551(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint16_t* dst, bool bswap);
+    // Depth: same units as GetPixelDepth; the far plane (the cleared value) reads as 0xFFFC, the N64 Z clear value.
+    // ReadbackGetDepth returns false if (x, y) was not requested before the last Run().
+    void ReadbackRequestDepth(uint32_t x, uint32_t y);
+    bool ReadbackGetDepth(uint32_t x, uint32_t y, uint16_t* depth) const;
+    void ServiceReadbacks();
     void RegisterBlendedTexture(const char* name, uint8_t* mask, uint8_t* replacement);
     void UnregisterBlendedTexture(const char* name);
 
@@ -561,6 +573,19 @@ class Interpreter {
 
     std::set<std::pair<float, float>> mGetPixelDepthPending; // get_pixel_depth_pending;
     std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> mGetPixelDepthCached; // get_pixel_depth_cached;
+
+    struct ReadbackRequest {
+        uint32_t x, y, width, height;
+        uint16_t* dst;
+        bool bswap;
+    };
+    std::vector<ReadbackRequest> mReadbackRequests;
+    std::set<std::pair<uint32_t, uint32_t>> mReadbackDepthRequests;
+    std::map<std::pair<uint32_t, uint32_t>, uint16_t> mReadbackDepthResults;
+    std::vector<uint16_t> mReadbackBuffer;
+    int mReadbackFb = -1;
+    uint32_t mReadbackFbWidth = 0;
+    uint32_t mReadbackFbHeight = 0;
     std::map<std::string, MaskedTextureEntry, std::less<>> mMaskedTextures;
     std::unordered_map<uintptr_t, int> mFbTextures; // CPU addr -> GPU FB id
 
@@ -588,6 +613,10 @@ const char* GfxGetOpcodeName(int8_t opcode);
 } // namespace Fast
 
 extern "C" void gfx_texture_cache_clear();
+extern "C" void gfx_readback_rgba5551(uint32_t x, uint32_t y, uint32_t width, uint32_t height, uint16_t* dst,
+                                      bool bswap);
+extern "C" void gfx_readback_depth_request(uint32_t x, uint32_t y);
+extern "C" bool gfx_readback_depth_get(uint32_t x, uint32_t y, uint16_t* depth);
 extern "C" void gfx_shader_cache_clear();
