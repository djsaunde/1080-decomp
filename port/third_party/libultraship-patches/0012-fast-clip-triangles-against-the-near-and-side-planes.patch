+// Clips a triangle the way the F3DEX microcodes do: in clip space, against the near plane (z = -w) and the four
+// side planes at the clip ratio (x, y = +-ratio * w); there is no far plane. A new vertex takes the position, texture
+// coordinates and colour of its edge at the crossing, linearly in clip space; its fog factor is computed again from
+// its own z / w, as for a loaded vertex. Returns the polygon's vertex count (0 if nothing is left) in out[].
+int Interpreter::ClipPolygon(const LoadedVertex* const in[3], LoadedVertex* buf, const LoadedVertex** out) {
+    const LoadedVertex* poly[2][10];
+    int n = 3;
+    int cur = 0;
+    int used = 0;
+    const float r = (float)mClipRatio;
+    for (int i = 0; i < 3; i++) {
+        poly[0][i] = in[i];
+    }
+    for (int plane = 0; plane < 5; plane++) {
+        auto dist = [&](const LoadedVertex* v) {
+            switch (plane) {
+                case 0:
+                    return v->z + v->w; // near
+                case 1:
+                    return r * v->w + v->x;
+                case 2:
+                    return r * v->w - v->x;
+                case 3:
+                    return r * v->w + v->y;
+                default:
+                    return r * v->w - v->y;
+            }
+        };
+        const LoadedVertex** src = poly[cur];
+        const LoadedVertex** dst = poly[cur ^ 1];
+        int m = 0;
+        for (int i = 0; i < n; i++) {
+            const LoadedVertex* a = src[i];
+            const LoadedVertex* b = src[(i + 1) % n];
+            float da = dist(a), db = dist(b);
+            if (da >= 0) {
+                dst[m++] = a;
+            }
+            if ((da >= 0) != (db >= 0) && m < 10 && used < 16) {
+                float t = da / (da - db);
+                LoadedVertex* c = &buf[used++];
+                c->x = a->x + (b->x - a->x) * t;
+                c->y = a->y + (b->y - a->y) * t;
+                c->z = a->z + (b->z - a->z) * t;
+                c->w = a->w + (b->w - a->w) * t;
+                c->u = a->u + (b->u - a->u) * t;
+                c->v = a->v + (b->v - a->v) * t;
+                c->color.r = (uint8_t)lroundf(a->color.r + (b->color.r - a->color.r) * t);
+                c->color.g = (uint8_t)lroundf(a->color.g + (b->color.g - a->color.g) * t);
+                c->color.b = (uint8_t)lroundf(a->color.b + (b->color.b - a->color.b) * t);
+                c->color.a = (uint8_t)lroundf(a->color.a + (b->color.a - a->color.a) * t);
+                if ((mRsp->geometry_mode & G_FOG) && c->w > 0.0f) {
+                    float fog_z = c->z / c->w * mRsp->fog_mul + mRsp->fog_offset;
+                    c->color.a = (uint8_t)Ship::Math::clamp(fog_z, 0.0f, 255.0f);
+                }
+                c->clip_rej = 0;
+                dst[m++] = c;
+            }
+            if (m >= 10) {
+                break;
+            }
+        }
+        n = m;
+        cur ^= 1;
+        if (n < 3) {
+            return 0;
+        }
+    }
+    // The RSP draws the clipped polygon as a fan around its last vertex. With screen-space linear shading the
+    // pivot matters (each fan triangle interpolates only its own corners); the first vertex as pivot measured
+    // up to 16 levels off the N64 on 1080's near-camera slopes (title demo 4372-4391), the last one matches.
+    for (int i = 0; i < n; i++) {
+        out[i] = poly[cur][(i + n - 1) % n];
+    }
+    return n;
+}
