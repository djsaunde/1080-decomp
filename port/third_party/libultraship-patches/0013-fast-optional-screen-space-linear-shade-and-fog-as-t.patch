--- a/src/fast/backends/gfx_opengl.cpp
+++ b/src/fast/backends/gfx_opengl.cpp
@@ -244,6 +244,18 @@ std::optional<std::string> opengl_include_fs(const std::string& path) {
     return *inc;
 }
 
+// N64 shading (SetAffineShading): the RDP steps shade colour and the fog factor linearly in screen space. The shaders
+// do not use the `noperspective` qualifier for it: the vertex shader outputs each such varying times w, and w itself,
+// both interpolated perspective-correctly, and the fragment shader divides them, which is the screen-linear value.
+// The driver's clipper then treats them as ordinary varyings. Mesa's (llvmpipe, softpipe; desktop GL and ES) computes
+// a noperspective varying at a clipped vertex from the screen-space ratio along x whenever the clip-space x differ,
+// which is 0 / 0 for an edge lying on a side plane: NaN shade, the whole clipped triangle black.
+static bool sAffineShading = false;
+
+void GfxRenderingAPIOGL::SetAffineShading(bool affine) {
+    sAffineShading = affine;
+}
