+void Interpreter::CopyColorReadback(const ReadbackRequest& req, uint32_t width, uint32_t height) {
+    for (uint32_t row = 0; row < req.height; row++) {
+        for (uint32_t col = 0; col < req.width; col++) {
+            const uint32_t x = req.x + col;
+            const uint32_t y = req.y + row;
+            uint16_t pixel = (x < width && y < height) ? mReadbackBuffer[(size_t)y * width + x] : 0;
+#ifndef IS_BIGENDIAN
+            if (req.bswap) {
+                pixel = BE16SWAP(pixel);
+            }
+#endif
+            req.dst[(size_t)row * req.width + col] = pixel;
+        }
+    }
+}
+
+void Interpreter::ReadbackRequestDepthGrid() {
+    mDepthGridWanted = true;
+}
+
+void Interpreter::BeginDepthGrid(int srcFb) {
+    // every native pixel, its coordinates converted as GetPixelDepth's (AdjustPixelDepthCoordinates: x depends only
+    // on x, y only on y)
+    const uint32_t w = mNativeDimensions.width, h = mNativeDimensions.height;
+    std::vector<float> xs(w), ys(h);
+    for (uint32_t i = 0; i < w; i++) {
+        float x = (float)i, y = 0;
+        AdjustPixelDepthCoordinates(x, y);
+        xs[i] = x;
+    }
+    for (uint32_t j = 0; j < h; j++) {
+        float x = 0, y = (float)j;
+        AdjustPixelDepthCoordinates(x, y);
+        ys[j] = y;
+    }
+    mRapi->ReadDepthGridBegin(srcFb, xs, ys);
+    mPendingDepthGrid = true;
+    mDepthGridW = w;
+    mDepthGridH = h;
+}
+
+void Interpreter::ServiceReadbacksAsync() {
+    const int srcFb = mRendersToFb ? mGameFb : 0;
+    if (mReadbackRequests.empty() && mReadbackDepthRequests.empty() && !mDepthGridWanted) {
+        return;
+    }
+    FinishReadbacks();
+    if (!mReadbackRequests.empty()) {
+        // as ServiceReadbacks: the game view's native-aspect centre, scaled to the native size, GPU-side
+        const uint32_t width = mNativeDimensions.width;
+        const uint32_t height = mNativeDimensions.height;
+        if (mReadbackFb < 0) {
+            mReadbackFb = mRapi->CreateFramebuffer();
+        }
+        if (mReadbackFbWidth != width || mReadbackFbHeight != height) {
+            mRapi->UpdateFramebufferParameters(mReadbackFb, width, height, 1, true, true, false, false);
+            mReadbackFbWidth = width;
+            mReadbackFbHeight = height;
+        }
+        int srcX0, srcY0, srcW, srcH;
+        if (srcFb == 0 || (mMsaaLevel > 1 && mCurDimensions.width == mGameWindowViewport.width &&
+                           mCurDimensions.height == mGameWindowViewport.height)) {
+            srcX0 = mGameWindowViewport.x;
+            srcY0 = mGameWindowViewport.y;
+            srcW = mGameWindowViewport.width;
+            srcH = mGameWindowViewport.height;
+        } else {
+            srcX0 = 0;
+            srcY0 = 0;
+            srcW = mCurDimensions.width;
+            srcH = mCurDimensions.height;
+        }
+        if ((float)srcW / srcH > (float)width / height) {
+            int sliceW = (int)((float)srcH * width / height);
+            srcX0 += (srcW - sliceW) / 2;
+            srcW = sliceW;
+        }
+        mRapi->CopyFramebuffer(mReadbackFb, srcFb, srcX0, srcY0, srcX0 + srcW, srcY0 + srcH, 0, 0, width, height);
+        mRapi->ReadFramebufferToCPUBegin(mReadbackFb, width, height);
+        mPendingColorReads = std::move(mReadbackRequests);
+        mReadbackRequests.clear();
+        mPendingColorW = width;
+        mPendingColorH = height;
+    }
+    mReadbackDepthResults.clear();
+    if (!mReadbackDepthRequests.empty() || mDepthGridWanted) {
+        BeginDepthGrid(srcFb);
+        mPendingDepthReads = std::move(mReadbackDepthRequests);
+        mReadbackDepthRequests.clear();
+    }
+    mDepthGridWanted = false;
+}
+
+void Interpreter::FinishReadbacks() {
+    if (!mPendingColorReads.empty()) {
+        const auto rt0 = std::chrono::steady_clock::now();
+        mReadbackBuffer.resize((size_t)mPendingColorW * mPendingColorH);
+        mRapi->ReadFramebufferToCPUFinish(mReadbackBuffer.data());
+        mReadbackStats.colorReads++;
+        mReadbackStats.colorUs += (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(
+                                      std::chrono::steady_clock::now() - rt0).count();
+        for (const auto& req : mPendingColorReads) {
+            CopyColorReadback(req, mPendingColorW, mPendingColorH);
+        }
+        mPendingColorReads.clear();
+    }
+    if (mPendingDepthGrid) {
+        const auto rt0 = std::chrono::steady_clock::now();
+        mDepthGrid.assign((size_t)mDepthGridW * mDepthGridH, 0xFFFC);
+        mRapi->ReadDepthGridFinish(mDepthGrid.data());
+        mReadbackStats.depthReads++;
+        mReadbackStats.depthPixels += mDepthGrid.size();
+        mReadbackStats.depthUs += (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(
+                                      std::chrono::steady_clock::now() - rt0).count();
+        mPendingDepthGrid = false;
+        mDepthGridValid = true;
+        for (const auto& request : mPendingDepthReads) {
+            if (request.first < mDepthGridW && request.second < mDepthGridH) {
+                mReadbackDepthResults.emplace(request, mDepthGrid[(size_t)request.second * mDepthGridW + request.first]);
+            }
+        }
+        mPendingDepthReads.clear();
+    }
+}
+
+void Interpreter::ReadbackDepthGridNow() {
+    FinishReadbacks();
+    BeginDepthGrid(mRendersToFb ? mGameFb : 0);
+    FinishReadbacks();
+}
+
+bool Interpreter::ReadbackGridDepth(uint32_t x, uint32_t y, uint16_t* depth) {
+    if (mPendingDepthGrid) {
+        FinishReadbacks();
+    }
+    if (!mDepthGridValid || x >= mDepthGridW || y >= mDepthGridH) {
+        return false;
+    }
+    *depth = mDepthGrid[(size_t)y * mDepthGridW + x];
+    return true;
+}
