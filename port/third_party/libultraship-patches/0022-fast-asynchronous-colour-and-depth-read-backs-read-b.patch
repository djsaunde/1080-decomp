 namespace Fast {
@@ -80,7 +81,45 @@ class GfxRenderingAPI {
     virtual ImTextureID GetTextureById(int id) = 0;
     virtual void SetCurrentPrimDepth(float depth) = 0;
 
+    // Asynchronous read-backs, for a port that reads the frame back while it goes on drawing: Begin queues the copy
+    // and returns; Finish waits for the GPU only if it has not finished the copy yet, then converts. One of each kind
+    // can be pending. The results equal ReadFramebufferToCPU's and GetPixelDepth's. Default: synchronous, at Begin.
+    virtual void ReadFramebufferToCPUBegin(int fbId, uint32_t width, uint32_t height) {
+        mAsyncColor.resize((size_t)width * height);
+        ReadFramebufferToCPU(fbId, width, height, mAsyncColor.data());
+    }
+    virtual void ReadFramebufferToCPUFinish(uint16_t* rgba16Buf) {
+        for (size_t i = 0; i < mAsyncColor.size(); i++) {
+            rgba16Buf[i] = mAsyncColor[i];
+        }
+    }
+    // The depth of a grid of pixels, as GetPixelDepth reads each: out[j * xs.size() + i] is the pixel (xs[i], ys[j]).
+    virtual void ReadDepthGridBegin(int fbId, const std::vector<float>& xs, const std::vector<float>& ys) {
+        std::set<std::pair<float, float>> coords;
+        for (float y : ys) {
+            for (float x : xs) {
+                coords.emplace(x, y);
+            }
+        }
+        auto res = GetPixelDepth(fbId, coords);
+        mAsyncDepth.assign(xs.size() * ys.size(), 0xFFFC);
+        for (size_t j = 0; j < ys.size(); j++) {
+            for (size_t i = 0; i < xs.size(); i++) {
+                auto it = res.find(std::make_pair(xs[i], ys[j]));
+                if (it != res.end()) {
+                    mAsyncDepth[j * xs.size() + i] = it->second;
+                }
+            }
+        }
+    }
+    virtual void ReadDepthGridFinish(uint16_t* out) {
+        for (size_t i = 0; i < mAsyncDepth.size(); i++) {
+            out[i] = mAsyncDepth[i];
+        }
+    }
+
   protected:
+    std::vector<uint16_t> mAsyncColor, mAsyncDepth;
     int8_t mCurrentDepthTest = 0;
     int8_t mCurrentDepthMask = 0;
     int8_t mCurrentZmodeDecal = 0;
