-void GfxRenderingAPIOGL::ReadFramebufferToCPU(int fb_id, uint32_t width, uint32_t height, uint16_t* rgba16_buf) {
-    if (fb_id >= (int)mFrameBuffers.size()) {
-        return;
-    }
-
-    // Read as RGBA8 (GL_UNSIGNED_BYTE) then convert to RGBA16 (5551).
-    // GL_RGBA + GL_UNSIGNED_SHORT_5_5_5_1 writes 4 separate u16 components per pixel
-    // (8 bytes) on some drivers (NVIDIA), not the packed 2 bytes the spec implies.
-    // Reading as RGBA8 and converting matches the DX11 path's approach.
-    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[fb_id].fbo);
-
-    std::vector<uint8_t> rgba8(width * height * 4);
-    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba8.data());
-
+void GfxRenderingAPIOGL::Rgba8ToRgba5551(const uint8_t* rgba8, uint32_t width, uint32_t height,
+                                         uint16_t* rgba16_buf) const {
     // The RDP's magic-square dither matrix (G_CD_MAGICSQ), indexed [y & 3][x & 3]
     static const uint8_t magic[16] = { 0, 6, 1, 7, 4, 2, 5, 3, 3, 5, 2, 4, 7, 1, 6, 0 };
     for (uint32_t i = 0; i < width * height; i++) {
@@ -1132,7 +1120,320 @@ void GfxRenderingAPIOGL::ReadFramebufferToCPU(int fb_id, uint32_t width, uint32_
         uint8_t a = rgba8[i * 4 + 3] ? 1 : 0;
         rgba16_buf[i] = (r << 11) | (g << 6) | (b << 1) | a;
     }
+}
+
+void GfxRenderingAPIOGL::ReadFramebufferToCPU(int fb_id, uint32_t width, uint32_t height, uint16_t* rgba16_buf) {
+    if (fb_id >= (int)mFrameBuffers.size()) {
+        return;
+    }
+
+    // Read as RGBA8 (GL_UNSIGNED_BYTE) then convert to RGBA16 (5551).
+    // GL_RGBA + GL_UNSIGNED_SHORT_5_5_5_1 writes 4 separate u16 components per pixel
+    // (8 bytes) on some drivers (NVIDIA), not the packed 2 bytes the spec implies.
+    // Reading as RGBA8 and converting matches the DX11 path's approach.
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[fb_id].fbo);
+
+    std::vector<uint8_t> rgba8(width * height * 4);
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba8.data());
+    Rgba8ToRgba5551(rgba8.data(), width, height, rgba16_buf);
+
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+}
+
+// ---- asynchronous read-backs ----
+// Begin makes the GPU-side copy (the colour image scaled into the read-back framebuffer; the depth grid) and puts a
+// fence after it; Finish waits for the fence and only then reads the small copy back. A glReadPixels while the GPU is
+// still drawing the frame waits for all of it; on GL over D3D12 (Mesa's d3d12, WSLg) or Metal it is also a full
+// flush, and even a read into a pixel-pack buffer waits there (measured: 7-10 ms on a busy GPU). Read later, once the
+// fence has signalled (the port reads at the game's next step), it is a copy of 300 KB.
+bool GfxRenderingAPIOGL::AsyncReadWait(AsyncRead& r) {
+    if (!r.pending) {
+        return false;
+    }
+    r.pending = false;
+    GLenum w = GL_TIMEOUT_EXPIRED;
+    for (int i = 0; i < 20 && w == GL_TIMEOUT_EXPIRED; i++) { // at most ~2 s
+        w = glClientWaitSync(r.fence, GL_SYNC_FLUSH_COMMANDS_BIT, 100000000ull);
+    }
+    glDeleteSync(r.fence);
+    r.fence = nullptr;
+    if (w == GL_WAIT_FAILED) {
+        fprintf(stderr, "fast: waiting for a read-back's fence failed\n");
+    }
+    return true; // the read below waits for the copy in any case
+}
+
+void GfxRenderingAPIOGL::AsyncReadFence(AsyncRead& r, GLuint fbo, uint32_t width, uint32_t height) {
+    r.fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    r.fbo = fbo;
+    r.width = width;
+    r.height = height;
+    r.pending = true;
+}
+
+void GfxRenderingAPIOGL::ReadFramebufferToCPUBegin(int fb_id, uint32_t width, uint32_t height) {
+    AsyncRead& r = mAsyncColorRead;
+    if (fb_id >= (int)mFrameBuffers.size()) {
+        return;
+    }
+    if (r.pending) { // an earlier copy nobody took: its fence goes
+        AsyncReadWait(r);
+    }
+    AsyncReadFence(r, mFrameBuffers[fb_id].fbo, width, height);
+}
+
+void GfxRenderingAPIOGL::ReadFramebufferToCPUFinish(uint16_t* rgba16_buf) {
+    AsyncRead& r = mAsyncColorRead;
+    if (!AsyncReadWait(r)) {
+        return;
+    }
+    std::vector<uint8_t> rgba8((size_t)r.width * r.height * 4);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, r.fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, (GLsizei)r.width, (GLsizei)r.height, GL_RGBA, GL_UNSIGNED_BYTE, rgba8.data());
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+    Rgba8ToRgba5551(rgba8.data(), r.width, r.height, rgba16_buf);
+}
+
+static GLuint GridCompile(GLenum type, const char* src) {
+    GLuint sh = glCreateShader(type);
+    glShaderSource(sh, 1, &src, nullptr);
+    glCompileShader(sh);
+    GLint ok = 0;
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[1024];
+        GLsizei n = 0;
+        glGetShaderInfoLog(sh, sizeof(log), &n, log);
+        fprintf(stderr, "fast: depth grid shader: %.*s\n", (int)n, log);
+    }
+    return sh;
+}
 
+bool GfxRenderingAPIOGL::DepthGridInit() {
+    DepthGrid& d = mDepthGrid;
+    if (d.prog != 0 || d.broken) {
+        return !d.broken;
+    }
+#if defined(USE_OPENGLES)
+    const char* head = "#version 300 es\nprecision highp float;\nprecision highp int;\n";
+#elif defined(__APPLE__)
+    const char* head = "#version 410 core\n";
+#else
+    const char* head = "#version 130\n";
+#endif
+    const std::string vs = std::string(head) +
+                           "void main() {\n"
+                           "    gl_Position = vec4(float((gl_VertexID & 1) * 4 - 1), float((gl_VertexID & 2) * 2 - 1), "
+                           "0.0, 1.0);\n"
+                           "}\n";
+    // Each output pixel (i, j) takes the depth of the copy's pixel (map[i, 0], map[j, 1]). The depth goes out as the
+    // fragment's depth into a depth buffer of the same format, which is read back as GetPixelDepth reads it, and as
+    // 24 bits in RGBA8 (OpenGL ES, which reads no depth: as its GetPixelDepth).
+    const std::string fs = std::string(head) +
+                           "uniform highp sampler2D uDepth;\n"
+                           "uniform highp isampler2D uMap;\n"
+                           "uniform ivec2 uSize;\n"
+                           "out vec4 oColor;\n"
+                           "void main() {\n"
+                           "    ivec2 p = ivec2(gl_FragCoord.xy);\n"
+                           "    int sx = texelFetch(uMap, ivec2(p.x, 0), 0).r;\n"
+                           "    int sy = texelFetch(uMap, ivec2(p.y, 1), 0).r;\n"
+                           "    float z = 1.0;\n"
+                           "    if (sx >= 0 && sy >= 0 && sx < uSize.x && sy < uSize.y) {\n"
+                           "        z = texelFetch(uDepth, ivec2(sx, sy), 0).r;\n"
+                           "    }\n"
+                           "    gl_FragDepth = z;\n"
+                           "    uint u = uint(clamp(round(z * 16777215.0), 0.0, 16777215.0));\n"
+                           "    oColor = vec4(float((u >> 16) & 255u), float((u >> 8) & 255u), float(u & 255u), 255.0) / "
+                           "255.0;\n"
+                           "}\n";
+    GLuint v = GridCompile(GL_VERTEX_SHADER, vs.c_str()), f = GridCompile(GL_FRAGMENT_SHADER, fs.c_str());
+    d.prog = glCreateProgram();
+    glAttachShader(d.prog, v);
+    glAttachShader(d.prog, f);
+    glLinkProgram(d.prog);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    GLint ok = 0;
+    glGetProgramiv(d.prog, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        fprintf(stderr, "fast: depth grid program failed to link: depth is read pixel by pixel\n");
+        d.broken = true;
+        return false;
+    }
+    d.locDepth = glGetUniformLocation(d.prog, "uDepth");
+    d.locMap = glGetUniformLocation(d.prog, "uMap");
+    d.locSize = glGetUniformLocation(d.prog, "uSize");
+    glGenVertexArrays(1, &d.vao);
+    glGenTextures(1, &d.copyTex);
+    glGenTextures(1, &d.mapTex);
+    glGenFramebuffers(1, &d.copyFb);
+    glGenFramebuffers(1, &d.fb);
+    glGenRenderbuffers(1, &d.depthRb);
+    glGenRenderbuffers(1, &d.colorRb);
+    return true;
+}
+
+void GfxRenderingAPIOGL::ReadDepthGridBegin(int fb_id, const std::vector<float>& xs, const std::vector<float>& ys) {
+    DepthGrid& d = mDepthGrid;
+    AsyncRead& r = mAsyncDepthRead;
+    if (fb_id >= (int)mFrameBuffers.size() || xs.empty() || ys.empty() || !DepthGridInit()) {
+        GfxRenderingAPI::ReadDepthGridBegin(fb_id, xs, ys); // pixel by pixel, now
+        r.pending = false;
+        r.width = 0;
+        return;
+    }
+    if (r.pending) {
+        AsyncReadWait(r);
+    }
+    const FramebufferOGL& src = mFrameBuffers[fb_id];
+    const uint32_t gw = (uint32_t)xs.size(), gh = (uint32_t)ys.size();
+    for (int e = 0; e < 16 && glGetError() != GL_NO_ERROR; e++) {
+    }
+    // the state this changes, restored below (the backend caches some of it)
+    GLint prevActive = 0, prevTex0 = 0, prevTex1 = 0, prevProg = 0, prevVao = 0, prevVp[4], prevDepthFunc = GL_LESS;
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex0);
+    glActiveTexture(GL_TEXTURE1);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex1);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+    glGetIntegerv(GL_VIEWPORT, prevVp);
+    glGetIntegerv(GL_DEPTH_FUNC, &prevDepthFunc);
+    const GLboolean depthTest = glIsEnabled(GL_DEPTH_TEST), blend = glIsEnabled(GL_BLEND),
+                    cull = glIsEnabled(GL_CULL_FACE), scissor = glIsEnabled(GL_SCISSOR_TEST);
+    GLboolean colorMask[4], depthMask;
+    glGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+
+    // 1. the source's depth into a texture of its size (a 1:1 blit: the window's depth cannot be sampled)
+    if (d.copyW != src.width || d.copyH != src.height) {
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, d.copyTex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, (GLsizei)src.width, (GLsizei)src.height, 0,
+                     GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, d.copyFb);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, d.copyTex, 0);
+        d.copyW = src.width;
+        d.copyH = src.height;
+    }
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, src.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, d.copyFb);
+    glBlitFramebuffer(0, 0, (GLint)src.width, (GLint)src.height, 0, 0, (GLint)src.width, (GLint)src.height,
+                      GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT, GL_NEAREST);
+    const GLenum blitErr = glGetError();
+
+    // 2. the grid's source pixels, as GetPixelDepth converts its coordinates: (int)x, (int)y, flipped if invertY
+    const uint32_t mw = std::max(gw, gh);
+    std::vector<int32_t> map((size_t)mw * 2, -1);
+    for (uint32_t i = 0; i < gw; i++) {
+        map[i] = (int)xs[i];
+    }
+    for (uint32_t j = 0; j < gh; j++) {
+        int y = (int)ys[j];
+        map[mw + j] = src.invertY ? (int)src.height - y : y;
+    }
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, d.mapTex);
+    if (map != d.map) { // only when the view changed: rewriting a texture the last grid's draw reads can stall
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_R32I, (GLsizei)mw, 2, 0, GL_RED_INTEGER, GL_INT, map.data());
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        d.map = map;
+        d.mapW = mw;
+    }
+
+    // 3. the grid: one fragment per pixel writes its source pixel's depth
+    if (d.w != gw || d.h != gh) {
+        glBindRenderbuffer(GL_RENDERBUFFER, d.depthRb);
+        glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, (GLsizei)gw, (GLsizei)gh);
+        glBindRenderbuffer(GL_RENDERBUFFER, d.colorRb);
+        glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, (GLsizei)gw, (GLsizei)gh);
+        glBindRenderbuffer(GL_RENDERBUFFER, 0);
+        glBindFramebuffer(GL_FRAMEBUFFER, d.fb);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, d.depthRb);
+        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, d.colorRb);
+        d.w = gw;
+        d.h = gh;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, d.fb);
+    glViewport(0, 0, (GLsizei)gw, (GLsizei)gh);
+    glEnable(GL_DEPTH_TEST); // depth writes need the test on
+    glDepthFunc(GL_ALWAYS);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glUseProgram(d.prog);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, d.copyTex);
+    glUniform1i(d.locDepth, 0);
+    glUniform1i(d.locMap, 1);
+    glUniform2i(d.locSize, (GLint)src.width, (GLint)src.height);
+    glBindVertexArray(d.vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    // 4. the fence: ReadDepthGridFinish reads the grid back once the GPU is past it
+    AsyncReadFence(r, d.fb, gw, gh);
+    const GLenum err = glGetError();
+    if ((blitErr != GL_NO_ERROR || err != GL_NO_ERROR) && !d.warned) {
+        d.warned = true;
+        fprintf(stderr, "fast: depth grid: GL error 0x%x / 0x%x (the source's depth is not DEPTH24_STENCIL8?)\n",
+                blitErr, err);
+    }
+
+    // restore
+    glBindVertexArray((GLuint)prevVao);
+    glUseProgram((GLuint)prevProg);
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex1);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex0);
+    glActiveTexture((GLenum)prevActive);
+    glViewport(prevVp[0], prevVp[1], prevVp[2], prevVp[3]);
+    glColorMask(colorMask[0], colorMask[1], colorMask[2], colorMask[3]);
+    glDepthMask(depthMask);
+    glDepthFunc((GLenum)prevDepthFunc);
+    (depthTest ? glEnable : glDisable)(GL_DEPTH_TEST);
+    (blend ? glEnable : glDisable)(GL_BLEND);
+    (cull ? glEnable : glDisable)(GL_CULL_FACE);
+    (scissor ? glEnable : glDisable)(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+}
+
+void GfxRenderingAPIOGL::ReadDepthGridFinish(uint16_t* out) {
+    AsyncRead& r = mAsyncDepthRead;
+    if (!r.pending) {
+        GfxRenderingAPI::ReadDepthGridFinish(out); // the synchronous fallback's answers
+        return;
+    }
+    AsyncReadWait(r);
+    const uint32_t n = r.width * r.height;
+    std::vector<uint32_t> px(n, 0xFFFFFFFFu);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, r.fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+#ifdef USE_OPENGLES
+    glReadPixels(0, 0, (GLsizei)r.width, (GLsizei)r.height, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+    for (uint32_t i = 0; i < n; i++) {
+        const uint8_t* c = (const uint8_t*)&px[i];
+        const uint32_t d24 = ((uint32_t)c[0] << 16) | ((uint32_t)c[1] << 8) | c[2];
+        out[i] = (uint16_t)((d24 >> 10) << 2); // as this backend's ES GetPixelDepth
+    }
+#else
+    glReadPixels(0, 0, (GLsizei)r.width, (GLsizei)r.height, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, px.data());
+    for (uint32_t i = 0; i < n; i++) {
+        out[i] = (uint16_t)((px[i] >> 18) << 2); // as GetPixelDepth: the 24-bit depth's top 14 bits
+    }
+#endif
     glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
 }
 
