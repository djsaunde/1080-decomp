 }
 
+// F3DEX 1.x G_LINE3D shares its opcode with G_QUAD: w1 = v0 * 2 << 16 | v1 * 2 << 8 | width
+bool gfx_line3d_handler_f3dex(F3DGfx** cmd0) {
+    Interpreter* gfx = mInstance.lock().get();
+    F3DGfx* cmd = *cmd0;
+
+    gfx->GfxSpLine3D(C1(16, 8) / 2, C1(8, 8) / 2, C1(0, 8));
+    return false;
+}
