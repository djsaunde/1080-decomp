 include/fast/ucodehandlers.h                  |   3 +
 src/fast/interpreter.cpp                      | 107 +++++++++++++++++-
 .../resource/factory/DisplayListFactory.cpp   |   1 +
 4 files changed, 106 insertions(+), 6 deletions(-)

