+// Draws a G_LINE3D as a quad between two loaded vertices, extruded perpendicular to the line on screen.
+// The line is 1.5 + width / 2 N64 pixels thick (see gSPLineW3D in gbi.h). Lines are never culled.
+void Interpreter::GfxSpLine3D(uint8_t vtx1_idx, uint8_t vtx2_idx, uint8_t width) {
+    struct LoadedVertex* v1 = &mRsp->loaded_vertices[vtx1_idx];
+    struct LoadedVertex* v2 = &mRsp->loaded_vertices[vtx2_idx];
+
+    if (v1->clip_rej & v2->clip_rej) {
+        // The whole line lies outside the visible area
+        return;
+    }
+
+    if (v1->w <= 0.0f || v2->w <= 0.0f || mRdp->viewport.width == 0 || mRdp->viewport.height == 0) {
+        // LUSTODO: clip lines that cross the near plane instead of dropping them
+        return;
+    }
+
+    // Half the thickness in output pixels. Scale by the vertical ratio only, so that the thickness stays the
+    // same in both directions when the window is wider than the native aspect ratio.
+    const float half_px = (1.5f + width * 0.5f) * 0.5f * RATIO_Y(mActiveFrameBuffer, mCurDimensions);
+    const float vp_w = (float)mRdp->viewport.width;
+    const float vp_h = (float)mRdp->viewport.height;
+
+    // Line direction in output pixels
+    float dx = (v2->x / v2->w - v1->x / v1->w) * vp_w * 0.5f;
+    float dy = (v2->y / v2->w - v1->y / v1->w) * vp_h * 0.5f;
+    float len = sqrtf(dx * dx + dy * dy);
+    if (len == 0.0f) {
+        dx = 1.0f;
+        dy = 0.0f;
+        len = 1.0f;
+    }
+
+    // Perpendicular offset in normalized device coordinates
+    const float nx = -dy / len * half_px * 2.0f / vp_w;
+    const float ny = dx / len * half_px * 2.0f / vp_h;
+
+    struct LoadedVertex* q = &mRsp->loaded_vertices[MAX_VERTICES];
+    q[0] = *v1;
+    q[1] = *v1;
+    q[2] = *v2;
+    q[3] = *v2;
+    q[0].x += nx * v1->w;
+    q[0].y += ny * v1->w;
+    q[1].x -= nx * v1->w;
+    q[1].y -= ny * v1->w;
+    q[2].x -= nx * v2->w;
+    q[2].y -= ny * v2->w;
+    q[3].x += nx * v2->w;
+    q[3].y += ny * v2->w;
+
+    uint32_t geometry_mode_saved = mRsp->geometry_mode;
+    mRsp->geometry_mode &= ~get_attr(CULL_BOTH);
+
+    GfxSpTri1(MAX_VERTICES + 0, MAX_VERTICES + 1, MAX_VERTICES + 2, false);
+    GfxSpTri1(MAX_VERTICES + 0, MAX_VERTICES + 2, MAX_VERTICES + 3, false);
+
+    mRsp->geometry_mode = geometry_mode_saved;
+}
+
 void Interpreter::GfxSpGeometryMode(uint32_t clear, uint32_t set) {
     mRsp->geometry_mode &= ~clear;
     mRsp->geometry_mode |= set;
@@ -3939,6 +3999,15 @@ bool gfx_quad_handler_f3dex(F3DGfx** cmd0) {
