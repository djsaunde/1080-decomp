# GOAL 3899   (entries[0].pct reaches 100)
# WIN   (the player finishes first: the CPU rider finishes at 3959)
F 4199:3 A      # result screens
F 4319:3 A      # result screens -> Round 2
F 4600:3 START  # Round 2: pause
F 4660:3 DD     # pause menu: Continue -> Retire
F 4720:3 DD     # -> Restart
F 4780:3 DD     # -> Quit
