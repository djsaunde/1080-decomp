F 5511:3 A      # name entry: A
F 5571:3 A      # name entry: A
F 5631:3 A      # name entry: END
F 5691:3 A      # name entry: END (again: the first press can land before the cursor takes input)
F 5869:3 A      # Best Times -> TimMenu
F 5978:3 DD     # TimMenu: Retry -> View Replay
F 6038:3 A      # View Replay
# REPLAY END 9382
