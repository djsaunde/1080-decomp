# CMake toolchain: 32-bit Windows (i686-w64-mingw32), plan section 29.
#   cmake -S port -B <b> -G Ninja -DCMAKE_TOOLCHAIN_FILE=port/win32/mingw-i686.cmake -DPORT_WIN32=ON -DPORT_LINK=ON
# MINGW_ROOT: the prefix holding bin/i686-w64-mingw32-gcc*; default the no-sudo copy of setup-mingw.sh
# (tools/mingw-w64/root/usr), /usr on a machine (CI) with the distribution's g++-mingw-w64-i686 package.
# MINGW_SUFFIX: "-posix" (the posix-threads variant, std::thread) or "" when the plain names are posix.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
get_filename_component(_mono "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
if(NOT MINGW_ROOT)
  if(DEFINED ENV{MINGW_ROOT})
    set(MINGW_ROOT "$ENV{MINGW_ROOT}")
  elseif(EXISTS "${_mono}/tools/mingw-w64/root/usr/bin/i686-w64-mingw32-gcc-posix")
    set(MINGW_ROOT "${_mono}/tools/mingw-w64/root/usr")
  else()
    set(MINGW_ROOT "/usr")
  endif()
endif()
if(NOT DEFINED MINGW_SUFFIX)
  if(EXISTS "${MINGW_ROOT}/bin/i686-w64-mingw32-gcc-posix")
    set(MINGW_SUFFIX "-posix")
  else()
    set(MINGW_SUFFIX "")
  endif()
endif()
set(MINGW_ROOT "${MINGW_ROOT}" CACHE PATH "mingw-w64 prefix")
set(MINGW_SUFFIX "${MINGW_SUFFIX}" CACHE STRING "compiler name suffix")
set(CMAKE_C_COMPILER   "${MINGW_ROOT}/bin/i686-w64-mingw32-gcc${MINGW_SUFFIX}")
set(CMAKE_CXX_COMPILER "${MINGW_ROOT}/bin/i686-w64-mingw32-g++${MINGW_SUFFIX}")
set(CMAKE_ASM_COMPILER "${MINGW_ROOT}/bin/i686-w64-mingw32-gcc${MINGW_SUFFIX}")
set(CMAKE_RC_COMPILER  "${MINGW_ROOT}/bin/i686-w64-mingw32-windres")
set(CMAKE_AR           "${MINGW_ROOT}/bin/i686-w64-mingw32-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB       "${MINGW_ROOT}/bin/i686-w64-mingw32-ranlib" CACHE FILEPATH "")
set(CMAKE_NM           "${MINGW_ROOT}/bin/i686-w64-mingw32-nm" CACHE FILEPATH "")
set(CMAKE_OBJCOPY      "${MINGW_ROOT}/bin/i686-w64-mingw32-objcopy" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${MINGW_ROOT}/i686-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
